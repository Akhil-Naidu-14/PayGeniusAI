@"
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*

# Keep the example environment file
!.env.example

# Flask instance data
instance/*.db
instance/*.sqlite
instance/*.sqlite3

# Test / coverage files
.pytest_cache/
.coverage
htmlcov/

# IDE / editor files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Build / distribution
build/
dist/
*.egg-info/
"@ | Set-Content .gitignore