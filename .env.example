# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development

# Security (Required: Generate a strong random key in production)
SECRET_KEY=your-secure-secret-key-here

# Database
# For PostgreSQL: postgresql://username:password@hostname:5432/databasename
DATABASE_URL=sqlite:///paygenius.db

# Your gemini api key
GEMINI_API_KEY=your_actual_key_here